# Copy this file to .env.local. Empty values keep the app in demo mode.
# Supabase Dashboard > Project Settings > API / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: required for publication-checked photo delivery from private Storage.
# Set the real value only in ignored .env.local or Vercel environment settings.
SUPABASE_SECRET_KEY=

# Used for metadata. Set to https://invitly.co.in in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server only: welcome form details are POSTed here; an empty URL hides the form.
# Use the receiver's HTTPS webhook URL. Never prefix either value with NEXT_PUBLIC_.
INVITLY_VISITOR_WEBHOOK_URL=
# Optional Bearer token for a receiver that requires Authorization.
INVITLY_VISITOR_WEBHOOK_TOKEN=
# Set false to switch the greeting off without removing the webhook settings.
INVITLY_VISITOR_WELCOME_ENABLED=true

# Never add a service_role key, secret key, or database password here.

# Complete these before publishing the pre-launch legal notices.
INVITLY_LEGAL_NAME=
INVITLY_PRIVACY_EMAIL=
INVITLY_LEGAL_COUNTRY=
# Set true only after retention, providers, infrastructure and legal text are reviewed.
INVITLY_LEGAL_REVIEWED=false
